# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server-only — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive (server-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional: root folder in Drive dedicated to Pensieve. If empty, Drive root is used.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Sessions (server-only, min 32 chars)
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
